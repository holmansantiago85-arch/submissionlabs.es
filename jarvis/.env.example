# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Model. Default is Claude Opus 5.
JARVIS_MODEL=claude-opus-5
# Effort: low | medium | high | xhigh | max
JARVIS_EFFORT=medium
# Server-side refusal fallbacks (1 = on, 0 = off)
JARVIS_FALLBACKS=1

# Assistant identity
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=James
JARVIS_TIMEZONE=Europe/Madrid

# Voice
JARVIS_WAKE_WORD=jarvis
JARVIS_TTS_VOICE=Daniel
JARVIS_TTS_RATE=190
# faster-whisper model: tiny | base | small | medium | large-v3
JARVIS_STT_MODEL=small
JARVIS_STT_LANGUAGE=en

# Shell tool: commands allowed to run without confirmation (comma-separated prefixes)
JARVIS_SHELL_ALLOWLIST=ls,cat,head,tail,pwd,date,cal,df,du,uptime,whoami,open,say,osascript,ping,curl,brew list,git status,git log
# Set to 1 to let Jarvis run any shell command (not recommended)
JARVIS_SHELL_UNRESTRICTED=0

# Storage
JARVIS_DATA_DIR=./data
